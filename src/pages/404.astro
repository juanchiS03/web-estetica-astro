---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/servicios.js";
---

<Layout title={`Página no encontrada | ${siteConfig.nombreLegal}`}>
    <section class="relative flex flex-col items-center justify-center min-h-[75vh] text-center px-6 py-20 overflow-hidden bg-brand-bg">
        
        <!-- Número 404 decorativo de fondo con tipografía Serif -->
        <span 
            aria-hidden="true"
            class="font-serif italic font-normal text-brand-lilac/25 select-none pointer-events-none leading-none"
            style="font-size: clamp(7rem, 20vw, 15rem);"
        >
            404
        </span>

        <!-- Contenido superpuesto -->
        <div class="relative z-10 -mt-8 sm:-mt-12 max-w-lg mx-auto flex flex-col items-center">
            <span class="text-[11px] uppercase tracking-[0.25em] text-brand-lilac-dark font-semibold block mb-3">
                Enlace no disponible
            </span>

            <h1 class="font-serif text-3xl sm:text-5xl text-brand-dark font-normal mb-4">
                Página no encontrada
            </h1>

            <div class="h-px w-12 bg-brand-lilac-dark/40 my-4"></div>

            <p class="text-brand-muted text-sm sm:text-base font-light leading-relaxed mb-10">
                Parece que la página o el tratamiento que buscas ha cambiado de dirección. Puedes regresar al inicio o explorar nuestra carta de servicios.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
                <a
                    href="/"
                    class="w-full sm:w-auto bg-brand-dark text-white px-8 py-4 rounded-full text-xs uppercase tracking-[0.15em] font-semibold hover:bg-brand-dark/85 transition-all shadow-sm"
                >
                    Volver al Inicio
                </a>
                <a
                    href="/#servicios"
                    class="w-full sm:w-auto bg-transparent text-brand-dark border border-brand-border px-8 py-4 rounded-full text-xs uppercase tracking-[0.15em] font-semibold hover:border-brand-dark transition-all"
                >
                    Ver Tratamientos
                </a>
            </div>
        </div>

    </section>
</Layout>