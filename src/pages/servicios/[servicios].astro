---
import Layout from "../../layouts/Layout.astro";
import { serviciosData } from "../../data/servicios.js";

export function getStaticPaths() {
    return serviciosData.map((s) => ({
        params: { servicios: s.slug },
        props: { info: s },
    }));
}

const { info } = Astro.props;
---

<Layout title={`${info.titulo} | Estética Sandra Mz. Córdoba`}>
    <section class="py-16 md:py-24 bg-brand-bg">
        <div class="max-w-4xl mx-auto px-6">
            
            <!-- Enlace volver -->
            <div class="mb-8">
                <a
                    href="/#servicios"
                    data-astro-prefetch
                    class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-brand-muted hover:text-brand-dark transition-colors"
                >
                    <span>←</span> Volver a tratamientos
                </a>
            </div>

            <!-- Cabecera del Servicio -->
            <div class="mb-14">
                <span class="text-[11px] uppercase tracking-[0.25em] text-brand-lilac-dark font-semibold block mb-3">
                    {info.categoria || "Tratamiento Especializado"}
                </span>
                <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl text-brand-dark font-normal leading-tight">
                    {info.titulo}
                </h1>
                <p class="mt-5 text-brand-muted text-base md:text-lg font-light leading-relaxed max-w-2xl">
                    {info.descripcion}
                </p>
            </div>

            <!-- Carta de Tarifas Editorial -->
            <div class="bg-white rounded-2xl border border-brand-border p-8 sm:p-12 shadow-xs">
                <div class="flex items-center justify-between pb-6 mb-6 border-b border-brand-border">
                    <h2 class="font-serif text-2xl sm:text-3xl text-brand-dark font-normal">
                        Carta de Tarifas
                    </h2>
                    <span class="text-xs uppercase tracking-[0.15em] text-brand-muted">
                        Precios por sesión
                    </span>
                </div>

                <div class="divide-y divide-brand-border">
                    {info.precios.map((item: any) => (
                        <div class="py-6 first:pt-2 last:pb-2 flex flex-col sm:flex-row sm:items-center justify-between gap-4 group">
                            <div class="max-w-lg">
                                <div class="flex flex-wrap items-center gap-3">
                                    <h3 class="font-serif text-xl sm:text-2xl text-brand-dark font-normal group-hover:text-brand-lilac-dark transition-colors">
                                        {item.nombre}
                                    </h3>
                                    {item.duracion && (
                                        <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-brand-surface text-brand-muted font-medium">
                                            {item.duracion}
                                        </span>
                                    )}
                                </div>
                                <p class="text-brand-muted mt-1.5 text-sm font-light leading-relaxed">
                                    {item.detalle}
                                </p>
                            </div>

                            <div class="flex items-center justify-between sm:justify-end gap-6 pt-2 sm:pt-0 shrink-0">
                                <span class="font-serif text-2xl sm:text-3xl text-brand-dark font-semibold">
                                    {item.precio}
                                </span>
                                <a
                                    href={`https://wa.me/34638610289?text=${encodeURIComponent(`Hola Sandra, me gustaría reservar cita para ${info.titulo} (${item.nombre}).`)}`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="px-4 py-2 rounded-full border border-brand-border text-[11px] uppercase tracking-[0.14em] font-semibold text-brand-dark hover:bg-brand-dark hover:text-white hover:border-brand-dark transition-all"
                                >
                                    Reservar
                                </a>
                            </div>
                        </div>
                    ))}
                </div>

                <!-- Nota informativa inferior -->
                {info.nota && (
                    <div class="mt-10 p-5 rounded-xl bg-brand-surface border border-brand-border flex items-start gap-3">
                        <span class="text-brand-lilac-dark text-sm mt-0.5">✦</span>
                        <p class="text-xs sm:text-sm text-brand-muted font-light leading-relaxed">
                            {info.nota}
                        </p>
                    </div>
                )}

                <!-- CTA General -->
                <div class="mt-10 pt-8 border-t border-brand-border flex flex-col sm:flex-row items-center justify-between gap-4">
                    <p class="text-xs text-brand-muted font-light text-center sm:text-left">
                        ¿Tienes dudas sobre qué tratamiento o zona elegir? Te asesoramos sin compromiso.
                    </p>
                    <a
                        href={`https://wa.me/34638610289?text=${encodeURIComponent(`Hola Sandra, quería consultar información sobre ${info.titulo}.`)}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-full sm:w-auto text-center bg-brand-dark text-white px-7 py-3.5 rounded-full text-xs uppercase tracking-[0.15em] font-semibold hover:bg-brand-dark/85 transition-all shrink-0"
                    >
                        Consultar por WhatsApp
                    </a>
                </div>
            </div>

        </div>
    </section>
</Layout>