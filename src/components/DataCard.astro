---
import ClockIcon from "./ClockIcon.astro";
import MapIcon from "./MapIcon.astro";
import WhatsappIcon from "./WhatsappIcon.astro";
import { siteConfig, getWhatsappUrl } from "../data/servicios.js";

const { contacto, horario, seccionContacto } = siteConfig;
---

<div class="w-full bg-white rounded-2xl p-8 sm:p-10 md:p-12 border border-brand-border shadow-xs flex flex-col justify-between">
    
    <div>
        <span class="text-[11px] uppercase tracking-[0.22em] text-brand-lilac-dark font-semibold block mb-2">
            {seccionContacto.etiqueta}
        </span>
        <h2 class="font-serif text-3xl md:text-4xl text-brand-dark font-normal mb-3">
            {seccionContacto.titulo}
        </h2>
        <p class="text-brand-muted text-sm font-light leading-relaxed mb-10">
            {seccionContacto.descripcion}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
            
            <!-- Datos de contacto directo -->
            <div class="space-y-6">
                <div class="flex items-start gap-4">
                    <div class="size-10 shrink-0 rounded-full bg-brand-lilac-light flex items-center justify-center text-brand-dark mt-0.5">
                        <MapIcon />
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.15em] text-brand-muted font-semibold">Dirección</p>
                        <p class="text-brand-dark text-sm font-medium mt-1">
                            {contacto.direccionCalle}
                        </p>
                        <p class="text-brand-muted text-xs font-light">{contacto.direccionCiudad}</p>
                    </div>
                </div>

                <div class="flex items-start gap-4">
                    <div class="size-10 shrink-0 rounded-full bg-brand-lilac-light flex items-center justify-center text-brand-dark mt-0.5">
                        <WhatsappIcon />
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.15em] text-brand-muted font-semibold">Teléfono y WhatsApp</p>
                        <p class="text-brand-dark text-sm font-medium mt-1">{contacto.telefonoVisible}</p>
                        <p class="text-brand-muted text-xs font-light">Respuesta rápida en horario comercial</p>
                    </div>
                </div>
            </div>

            <!-- Caja de Horario dinámica -->
            <div class="bg-brand-bg rounded-xl p-5 border border-brand-border">
                <h3 class="font-sans text-xs uppercase tracking-[0.16em] text-brand-dark font-semibold mb-4 flex items-center gap-2">
                    <span class="text-brand-lilac-dark"><ClockIcon /></span> Horario de Apertura
                </h3>
                <div class="space-y-3 text-xs">
                    {horario.map((item, idx) => (
                        <div class={`flex justify-between items-center ${idx < horario.length - 1 ? "border-b border-brand-border pb-2.5" : "pt-0.5"}`}>
                            <span class="text-brand-muted">{item.dias}</span>
                            {item.cerrado ? (
                                <span class="text-brand-lilac-dark font-medium uppercase tracking-wider text-[10px]">
                                    {item.horas}
                                </span>
                            ) : (
                                <span class="text-brand-dark font-semibold">{item.horas}</span>
                            )}
                        </div>
                    ))}
                </div>
            </div>

        </div>
    </div>

    <!-- Botones de Acción Sobrios -->
    <div class="flex flex-col sm:flex-row gap-4 mt-10 pt-8 border-t border-brand-border">
        <a
            href={getWhatsappUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 bg-brand-dark text-white text-center py-4 px-6 rounded-full text-xs uppercase tracking-[0.15em] font-semibold hover:bg-brand-dark/85 transition-all flex items-center justify-center gap-2.5 shadow-sm"
        >
            <span class="size-4 flex items-center justify-center"><WhatsappIcon /></span>
            <span>Reservar por WhatsApp</span>
        </a>

        <a
            href={`tel:${contacto.telefonoLlamada}`}
            class="flex-1 bg-transparent text-brand-dark border border-brand-dark text-center py-4 px-6 rounded-full text-xs uppercase tracking-[0.15em] font-semibold hover:bg-brand-dark hover:text-white transition-all flex items-center justify-center"
        >
            Llamar al Centro
        </a>
    </div>

</div>