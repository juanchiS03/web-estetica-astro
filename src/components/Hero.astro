---
import { Image } from "astro:assets";
import imageHero from "../assets/hero-unas1.webp";
import { siteConfig, getWhatsappUrl } from "../data/servicios.js";

const { hero } = siteConfig;
---

<section class="relative w-full min-h-[580px] md:min-h-[680px] lg:min-h-[740px] flex items-center bg-[#111113] overflow-hidden">
  
  <!-- Contenedor de la imagen desplazado a la izquierda en pantallas grandes -->
  <div class="absolute inset-y-0 left-0 w-full lg:w-[72%] overflow-hidden">
    <Image
      src={imageHero}
      alt="Manicura profesional en Logroño"
      width={1920}
      height={1080}
      loading="eager"
      fetchpriority="high"
      format="webp"
      quality={95}
      class="w-full h-full object-cover object-center"
    />
    <div class="
      absolute inset-0 
      bg-gradient-to-r from-black/60 via-black/50 to-[#111113] 
      lg:from-transparent lg:via-[#111113]/40 lg:to-[#111113]
    "></div>
  </div>

  <!-- Contenido alineado a la derecha -->
  <div class="relative z-10 w-full px-6 sm:px-12 lg:px-20 xl:px-32 py-20 flex justify-end">
    <div class="max-w-xl text-left md:text-right flex flex-col items-start md:items-end">
      
      <span class="inline-block text-[11px] uppercase tracking-[0.28em] text-brand-lilac font-medium mb-4 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-xs border border-white/15">
        {hero.etiqueta}
      </span>

      <h1 class="font-serif text-white text-5xl sm:text-6xl xl:text-7xl font-normal leading-[1.08] tracking-tight">
        {hero.tituloLinea1} <br />
        <span class="italic font-light text-brand-lilac">{hero.tituloCursiva}</span>
        <br />
        {hero.tituloLinea2}
      </h1>

      <p class="text-zinc-300 mt-6 text-base md:text-lg font-light leading-relaxed max-w-md">
        {hero.descripcion}
      </p>

      <div class="mt-10 flex flex-wrap items-center md:justify-end gap-4 w-full sm:w-auto">
        <a
          href={getWhatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-brand-lilac text-brand-dark px-8 py-4 rounded-full text-xs font-semibold uppercase tracking-[0.16em] hover:bg-white transition-all duration-300 shadow-lg text-center"
        >
          {hero.botonPrincipal}
        </a>
        <a
          href="#servicios"
          class="px-8 py-4 rounded-full text-xs font-medium uppercase tracking-[0.16em] text-white border border-white/30 hover:bg-white/10 transition-all duration-300 text-center"
        >
          {hero.botonSecundario}
        </a>
      </div>

    </div>
  </div>
</section>