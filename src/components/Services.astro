---
import ServiceCard from "./ServiceCard.astro";
import imagenUnas from "../assets/services/manicura.webp";
import imagenMasaje from "../assets/services/masaje.webp";
import imagenDepilacion from "../assets/services/depilacion.webp";
import { siteConfig, resumenServiciosHome } from "../data/servicios.js";

const imagenesMap: Record<string, any> = {
  manicura: imagenUnas,
  masajes: imagenMasaje,
  laser: imagenDepilacion,
};

const { seccionServicios } = siteConfig;
---

<section id="servicios" class="py-24 md:py-32 bg-brand-bg border-b border-brand-border">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-12 lg:px-20">
    
    <!-- Encabezado Editorial -->
    <div class="text-center max-w-2xl mx-auto mb-16 md:mb-20">
      <span class="text-[11px] uppercase tracking-[0.25em] text-brand-lilac-dark font-semibold block mb-3">
        {seccionServicios.etiqueta}
      </span>
      <h2 class="font-serif text-4xl md:text-5xl text-brand-dark font-normal">
        {seccionServicios.titulo}
      </h2>
      <div class="h-px w-16 bg-brand-lilac-dark/40 mx-auto my-6"></div>
      <p class="text-brand-muted text-base font-light leading-relaxed">
        {seccionServicios.descripcion}
      </p>
    </div>

    <!-- Grid de Servicios -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
      {resumenServiciosHome.map((service) => (
        <ServiceCard 
          category={service.category}
          title={service.title} 
          description={service.description} 
          image={imagenesMap[service.id]} 
          link={service.link}
          ctaText={service.ctaText}
        />
      ))}
    </div>

  </div>
</section>