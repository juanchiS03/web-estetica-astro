---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/playfair-display/wght.css";
import "@fontsource-variable/montserrat/wght.css";
import { siteConfig } from "../data/servicios.js";

const {
	title = `${siteConfig.nombreLegal} · Centro de Estética en Logroño`,
	description = "Centro de Estética avanzada y bienestar en Logroño. Especialistas en manicura premium, pedicura spa, masajes relajantes y depilación láser.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://esteticasandramzcordoba.vercel.app/");

// Datos estructurados (JSON-LD) para SEO Local en Google
const schemaBeautySalon = {
	"@context": "https://schema.org",
	"@type": "BeautySalon",
	"name": siteConfig.nombreLegal,
	"alternateName": siteConfig.nombreCorto,
	"description": description,
	"url": canonicalURL.href,
	"telephone": siteConfig.contacto.telefonoLlamada,
	"priceRange": "€€",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": siteConfig.contacto.direccionCalle,
		"addressLocality": "Logroño",
		"addressRegion": "La Rioja",
		"postalCode": "26005",
		"addressCountry": "ES"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 42.4601,
		"longitude": -2.4445
	},
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
			"opens": "09:30",
			"closes": "20:00"
		},
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": "Saturday",
			"opens": "10:00",
			"closes": "14:00"
		}
	],
	"sameAs": [
		siteConfig.contacto.instagramUrl
	]
};
---

<!doctype html>
<html lang="es">
	<head>
		<ClientRouter />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Compartir en WhatsApp y Redes -->
		<meta property="og:locale" content="es_ES" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={siteConfig.nombreLegal} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#FAF8F5" />
		<title>{title}</title>

		<!-- Script SEO Local para Google -->
		<script type="application/ld+json" set:html={JSON.stringify(schemaBeautySalon)} />
	</head>
	<body id="inicio" class="flex flex-col min-h-screen bg-brand-bg text-brand-dark selection:bg-brand-lilac/40">
		<Navbar />
		<main class="flex-grow pt-20">
			<slot />
		</main>
		<Footer />
	</body>
</html>